---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME } from "@consts";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const allTechTalks = (await getCollection("techTalk"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const techTalks = await Promise.all(
  allTechTalks.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="flex flex-col-reverse sm:flex-row items-start justify-between">
      <h1
        class="animate text-2xl sm:text-3xl font-semibold dark:text-white/50 mb-6"
      >
        Code, Build & Ship
      </h1>
      <p id="loadTime" class="animate font-bold mb-2 sm:mb-0"></p>
    </div>
    <div class="space-y-16">
      <section class="space-y-3 text-black dark:text-white">
        <p class="animate">
          I'm Vijay Tembugade,<strong>
            Product-Centric Fullstack Developer
          </strong>
          with over 4+ years of experience, specializing in building high-performance,
          scalable, and maintainable web applications. My passion lies in deeply
          understanding end to end product needs and translating them into robust,
          user-centric solutions.
        </p>

        <p class="animate">
          I am currently working as a Software Engineer 2 at <strong>Zendesk</strong> in Pune, focusing on Custom Object and Custom Data Logic.
          Previously I worked as a Senior Software Developer at Intangles Lab, building B2B SaaS platforms for Fleet Management and Vehicle Telematics solutions.
        </p>

        <p class="animate">
          I possess a robust skill set spanning <strong>Frontend</strong> Technologies
          such as ReactJS, JavaScript & TypeScript, HTML5, CSS3, Redux, Webpack,
          NextJs, MaterialUI, TailwindCSS, Data Grids, Storybook, Circle-CI, and
          GitHub Actions. My expertise also encompasses <strong>Backend</strong>
          Technologies including NodeJS, ExpressJS, MongoDB, Prisma, JWT, PostgreSQL, Rspec,
          and Ruby on Rails.
        </p>

        
        <p class="animate hidden">
          I am currently working as a Software Engineer 2 at Zendesk in Pune, focusing on Custom Object and Custom Data Logic. In this role, I have improved application stability through robust testing with React Testing Library and designed interactive visualizations using React Flow to enhance user workflow efficiency
        </p>
        <p class="animate hidden">
          At Intangles Lab, I am working as Senior Frontend Developer where I
          spearheaded the migration of frontend tech stacks, significantly
          optimizing performance by reducing bundle size by 52% and improving
          Redux store management. I also developed over 40+ reusable Storybook
          UI components, establishing a consistent design language. My work
          included integrating Google Maps APIs for real-time vehicle tracking
          and developing various comprehensive dashboards for certification,
          financial analysis, and predictive health. I also optimized deployment
          pipelines, reducing CircleCI build time by approximately 25% and
          migrating to GitHub Actions.
        </p>
        <p class="animate hidden">
          Before this, I contributed to e-commerce platform development at
          Mirraw, focusing on user-friendly interfaces and system efficiency. I
          actively share my expertise through tech talks at ReactJsPune and
          contribute to open-source projects, and I'm always open to new
          collaborations or mentorship opportunities.
        </p>
      </section>
      <section class="flex animate gap-3 items-center">
        <Link
          href="https://www.linkedin.com/in/vijaytembugade/"
          external
          className="animate w-10 fill-black/50 hover:fill-black hover:dark:fill-white dark:fill-white/50 cursor-pointer"
        >
          <svg viewBox="0 0 24 24" data-v-18fff711=""
            ><title data-v-18fff711="">linkedin</title>
            <path
