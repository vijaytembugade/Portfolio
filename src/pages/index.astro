              data-v-18fff711=""></path></svg
          >
        </Link>
        <Link
          href="https://github.com/vijaytembugade"
          external
          className="animate w-10 fill-black/50 hover:fill-black hover:dark:fill-white dark:fill-white/50  cursor-pointer"
        >
          <svg viewBox="0 0 24 24" data-v-18fff711=""
            ><title data-v-18fff711="">github</title>
            <path
              d="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"
              data-v-18fff711=""></path></svg
          >
        </Link>
        <Link
          href="mailto:vijaytembugade21@gmail.com"
          external
          className="animate w-10 fill-black/50 hover:fill-black hover:dark:fill-white dark:fill-white/50  cursor-pointer"
        >
          <svg viewBox="0 0 24 24" data-v-18fff711=""
            ><title data-v-18fff711="">email</title>
            <path
              d="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
              data-v-18fff711=""></path></svg
          >
        </Link>
        <Link
          href="https://drive.google.com/file/d/112Q9oX6eZdVtKg6bVjTotJYGsOLfOqlV/view?usp=sharing"
          external
          className="animate text-xl w-10 fill-black/50 hover:fill-black hover:dark:fill-white dark:fill-white/50  cursor-pointer"
        >
          Resume
        </Link>
      </section>

      <section class="animate space-y-6 hidden">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            Tech Talk
          </h2>
        </div>
        <a
          target="_blank"
          href="https://www.linkedin.com/feed/update/urn:li:activity:7326983902756007936/"
          class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
        >
          <div class="flex flex-col flex-1 truncate">
            <div class="font-semibold">
              Redux at Scale: Building High Performance React applications with
              Redux
              <div class="text-sm">
                Presented and Talked about Advanced Redux Architecture with Saga
                , Data Normalization, Dynamic Module Loadlers and Reselect.
              </div>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
            >
              <line
                x1="5"
                y1="12"
                x2="19"
                y2="12"
                class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
              ></line>
              <polyline
                points="12 5 19 12 12 19"
                class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
              ></polyline>
            </svg>
          </div>
        </a>
        <a
          target="_blank"
          href="https://x.com/vijaytembugade/status/1682689671015575553"
          class="relative group flex flex-nowrap py-3 px-4 pr-10 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
        >
          <div class="flex flex-col flex-1 truncate">
            <div class="font-semibold">
              Tech Talk on Frontend Design with Microfrontends @ReactJsPune
              <div class="text-sm">
                Presented innovative microfrontend architecture techniques at
                ReactJsPune Meetup, showcasing Module Federation with Webpack as
                a solution for modular and independently deployable frontend
                components.
              </div>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
            >
              <line
                x1="5"
                y1="12"
                x2="19"
                y2="12"
                class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
              ></line>
              <polyline
                points="12 5 19 12 12 19"
                class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
              ></polyline>
            </svg>
          </div>
        </a>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-xl text-black dark:text-white">
            Tech Talks
          </h5>
          <!-- <Link href="/techTalk"> See all posts </Link> -->
        </div>
        <ul class="flex flex-col gap-4">
          {
            techTalks.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            Work Experience
          </h2>
          <Link href="/work"> See all work </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {
            work.map((entry) => (
              <li>
                <div class="text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>
                <div class="text-xl font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="text-sm opacity-75">{entry.data.role}</div>
                <article>
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            Personal projects
          </h2>
          <Link href="/projects"> See all projects </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-semibold text-xl text-black dark:text-white">
            Latest Blogs
          </h5>
          <Link href="/blog"> See all blogs </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {
            blog.map((post) => (
              <li>
                <ArrowCard entry={post} />
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
