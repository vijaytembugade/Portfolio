---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const talks = (await getCollection("techTalk"))
    .filter((post) => !post.data.draft)
    .reverse();
  return talks.map((project) => ({
    params: { slug: project.slug },
    props: project,
  }));
}
type Props = CollectionEntry<"techTalk">;

const teckTalk = Astro.props;
const { Content } = await teckTalk.render();
---

<PageLayout
  title={teckTalk.data.title}
  description={teckTalk.data.description}
  image={teckTalk.data.image}
  ogType="article"
  publishedTime={teckTalk.data.date}
  modifiedTime={teckTalk.data.date}
>
  <Container>
    <div class="animate">
      <BackToPrev href="/"> Back </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        &bull;
        <div class="font-base text-sm">
          {readingTime(teckTalk.body)}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {teckTalk.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
